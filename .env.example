# Sao chép thành .env trước khi chạy. Mọi secret chỉ lưu tại máy chủ.
PUBLIC_BASE_URL=http://localhost:4100
# HTTPS trực tiếp bằng fullchain PEM và khóa PEM (để trống khi TLS ở reverse proxy).
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
# URL truy cập bổ sung (ví dụ VS Code Forwarded Address), phân cách bằng dấu phẩy.
# localhost/127.0.0.1/[::1] thay thế nhau cùng giao thức/cổng ở mọi môi trường; các origin khác phải khai báo chính xác.
ALLOWED_ORIGINS=
# PORT/HOST chỉ áp dụng khi khởi động Modular Monolith.
PORT=4100
HOST=127.0.0.1
JWT_SECRET=dev-only-change-this-secret-to-a-very-long-random-value
INTERNAL_SERVICE_KEY=dev-internal-only-change-to-a-random-secret
# Chỉ bật true trong môi trường phát triển cần tài khoản demo. Bỏ biến này vẫn tắt demo.
DEMO_AUTH_ENABLED=false
DEMO_TEMPLATE_CHECKOUT_ENABLED=false
DEMO_ADMIN_CODE=
GIFT_TTL_DAYS=365
# Gia hạn thử nghiệm một lần trước khi hết hạn; 0 = tắt.
GIFT_RENEWAL_DAYS=0

# Tài khoản mẫu: chỉ tạo khi bật rõ ràng, không dùng trong production.
# Điền email/mật khẩu riêng tại .env; không commit .env.
TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_NAME="Tài khoản kiểm thử"
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
# sender | creator | admin (mặc định sender)
TEST_ACCOUNT_ROLE=sender

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4100/api/auth/google/callback
RECOVERY_MAIL_URL=
RECOVERY_MAIL_TOKEN=

# Zalo Social API v4: https://developers.zalo.me/
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_CALLBACK_URL=http://localhost:4100/api/auth/zalo/callback

# MySQL 8.4 LTS: chính thức thay thế PostgreSQL foundation.
# Chỉ bật IDENTITY_STORAGE/CATALOG_STORAGE=mysql sau khi import JSON sang MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=momevia_dev
MYSQL_USER=momevia
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Tùy chọn cho npm run db:migrate. Để trống cả hai để dùng MYSQL_USER/MYSQL_PASSWORD.
MYSQL_MIGRATION_USER=
MYSQL_MIGRATION_PASSWORD=
SUPPORT_STORAGE=json

# Chuyển dần Identity/Catalog sang MySQL; mặc định giữ JSON để bảo toàn dữ liệu.
# Sau import: nên bật cả hai để Favorites đáp ứng foreign key users.
IDENTITY_STORAGE=json
CATALOG_STORAGE=json

# v1.0: Bật sau Migration 004 và import JSON Gifts/Orders.
# CHECKOUT_STORAGE=mysql yêu cầu dữ liệu Users/Templates đã chuyển sang MySQL.
# Các giao dịch mua hàng vẫn chỉ là DEMO; không thu tiền thật.
CHECKOUT_STORAGE=json
GIFTS_STORAGE=json

# v1.1 Payment Foundation: chưa kích hoạt khi thiếu hợp đồng merchant/HTTPS công khai.
# Cần Identity, Catalog và Checkout đều sử dụng MySQL.
PAYMENT_ENABLED=false
PAYMENT_ENV=sandbox
PAYMENT_LIVE_ENABLED=false
# Chỉ bật sau migration 017 và kiểm tra QA; xem docs/PHASE02_CHECKOUT_KEYS.md.
PAYMENT_SCOPED_CHECKOUT_ENABLED=false
# Chỉ dành cho MySQL QA cô lập; không bật trên Railway hoặc production.
PUBLICATION_QUOTA_QA_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# WEBHOOK: /api/checkout/payments/webhooks/payos hoặc /momo
# Không bao giờ dùng redirect phía client làm bằng chứng thanh toán.

# Sender canvas; JSON chỉ dùng một process. Không đổi flag để chuyển/rollback dữ liệu.
# MySQL cần migration 012 (JSON không làm tròn tọa độ) và Identity/Catalog/Gifts cùng MySQL; Checkout cùng profile khi mẫu trả phí.
# Chuyển dữ liệu canvas bằng db:import:canvas, không dùng các importer legacy.
# Thư viện động cần migration 013; quản lý bằng db:canvas-library hoặc API Admin.
# Support MySQL cần migration 007 cho báo cáo và quy trình xử lý.
DESIGNS_STORAGE=json
CANVAS_READ_ENABLED=true
CANVAS_EDIT_ENABLED=true
CANVAS_PUBLISH_ENABLED=true
SFX_CREATE_ENABLED=true
# Âm cá nhân cần migration 014_canvas_audio. Tắt SFX_CREATE_ENABLED chỉ chặn tạo/đổi âm mới;
# giữ reader và các tệp SFX có phiên bản để quà đã xuất bản tiếp tục phát được.
# Khi tạm dừng writer, giữ CANVAS_READ_ENABLED=true để quà đã gửi còn hoạt động.
# Recipient-name rollout: existing links keep their reader when creation is off.
RECIPIENT_NAMING_ENABLED=true
# Optional comma-separated owner UUIDs for a limited rollout; empty allows all.
RECIPIENT_NAMING_OWNER_IDS=
# Emergency stop for NEW self-name confirmations only; retries remain readable.
RECIPIENT_CONFIRMATIONS_ENABLED=true

# Phase 1: bật strict sau khi xác minh kho MySQL và ổ đĩa bền vững hiện có.
# Không đổi storage hoặc data root chỉ để vượt qua kiểm tra.
PRODUCTION_STRICT=false
MOMEVIA_DATA_DIR=
# Giới hạn theo mỗi pool (mặc định giữ nguyên 5); giảm dần khi đo tải thực tế.
MYSQL_CONNECTION_LIMIT=5
