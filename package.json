    "mysql2": "3.24.6",
    "qrcode-generator": "2.0.4",
    "read-excel-file": "6.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "js-yaml": "5.5.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.1"
  }
