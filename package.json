    "check:production": "node scripts/quality/check-production.mjs",
    "audit:technical": "node scripts/quality/audit-technical.mjs",
    "check:technical": "node scripts/quality/audit-technical.mjs --built",
    "audit:assets": "node scripts/quality/audit-assets.mjs",
    "audit:unused": "node scripts/quality/audit-unused.mjs",
    "audit:architecture": "node scripts/quality/audit-architecture.mjs",
