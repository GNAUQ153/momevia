# SVG xem trước tự sinh bằng Node dùng LF cố định trên mọi hệ điều hành.
web/assets/basic-templates/*.svg text eol=lf
web/assets/basic-templates/en/*.svg text eol=lf

# Giữ byte của SVG nguồn khớp với sourceHash trong manifest đồ họa.
web/assets/event-cards/refined-v1/*-source.svg -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve third-party license bytes and hashes exactly as shipped in source ZIPs.
web/assets/audio-licenses/*-upstream-*.txt binary

# Giữ nguyên byte OFL để xác minh checksum; khoảng trắng cuối dòng thuộc văn bản gốc.
web/assets/fonts/app/bricolagegrotesque-OFL.txt -text whitespace=-blank-at-eol
web/assets/fonts/app/bevietnampro-OFL.txt -text whitespace=-blank-at-eol
web/assets/fonts/app/fraunces-OFL.txt -text whitespace=-blank-at-eol

# Keep reviewed upstream animation/player bytes stable for checksum checks on Windows.
web/assets/animations/goodeisgn-gift-opening.json -text
web/js/vendor/lottie-light.mjs -text
web/js/vendor/LOTTIE_LICENSE.txt -text
