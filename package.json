{
  "name": "momevia-mvp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build/web.mjs",
    "check": "node scripts/quality/check-source.mjs && node scripts/quality/check-ui-i18n.mjs --check",
    "changelog:check": "node scripts/quality/check-changelog.mjs --staged",
    "package": "node scripts/release/package.mjs",
    "verify:package": "node scripts/release/verify.mjs dist/release",
    "dev": "node dev.mjs",
    "start": "node dev.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:architecture": "node tests/integration/architecture.mjs",
    "test:browser": "node tests/integration/architecture.mjs --browser",
    "test:demo:browser": "node tests/integration/web-demo.mjs",
    "test:canvas": "node tests/integration/canvas.mjs",
    "test:canvas:browser": "node tests/integration/canvas.mjs --browser",
    "test:canvas:mysql": "node tests/integration/canvas-mysql.mjs",
    "test:canvas:mysql:api": "node tests/integration/canvas-mysql-api.mjs --browser",
    "test:templates": "node tests/integration/template-library.mjs",
    "smoke": "node tests/smoke/http.mjs upgrade",
    "smoke:auth": "node tests/smoke/http.mjs auth",
    "smoke:upgrade": "node tests/smoke/http.mjs upgrade",
    "smoke:legacy": "node tests/smoke/http.mjs legacy",
    "seed:test-user": "node scripts/dev/seed-test-user.mjs",
    "smoke:ui": "node tests/smoke/http.mjs ui",
    "demo:web": "npm run build && node scripts/dev/web-demo.mjs",
    "dev:legacy": "node src/bootstrap/legacy.mjs",
    "test:architecture:legacy": "node tests/integration/architecture.mjs --legacy",
    "db:prepare": "node database/scripts/prepare-import.mjs",
    "db:migrate": "node database/scripts/mysql-migrate.mjs",
    "db:ping": "node database/scripts/mysql-ping.mjs",
    "db:verify": "node database/scripts/mysql-verify.mjs",
    "test:database": "node --test tests/unit/mysql-*.test.mjs",
    "db:import:identity-catalog": "node database/scripts/import-identity-catalog.mjs",
    "db:import:gifts-checkout": "node database/scripts/import-gifts-checkout.mjs",
    "i18n:audit": "node scripts/quality/check-ui-i18n.mjs --report",
    "perf:marketing": "node scripts/quality/measure-marketing.mjs",
    "perf:marketing:compare": "node scripts/quality/compare-marketing.mjs"
  },
  "dependencies": {
    "@payos/node": "2.0.6",
    "fabric": "7.4.0",
    "mysql2": "3.24.6",
    "qrcode-generator": "2.0.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "js-yaml": "5.5.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.1"
  }
}
