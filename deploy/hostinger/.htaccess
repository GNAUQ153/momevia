# Momevia: Hostinger Premium — static frontend + temporary same-origin API relay.
# Only upload this file to the intended Momevia site's public_html.
Options -MultiViews
DirectoryIndex index.html

# Hostinger trả .mjs là text/plain; kèm nosniff, trình duyệt sẽ từ chối chạy module
# (Fabric Studio, đọc file Excel danh sách người nhận). Khai báo đúng kiểu JavaScript.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
RewriteEngine On

# One canonical origin is important for session cookies and shared links.
RewriteCond %{HTTP_HOST} ^www\.momevia\.io\.vn$ [NC]
RewriteRule ^ https://momevia.io.vn%{REQUEST_URI} [R=301,L]

# Let Hostinger handle SSL certificates; enforce HTTPS for the production hostname.
RewriteCond %{HTTP_HOST} ^momevia\.io\.vn$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://momevia.io.vn%{REQUEST_URI} [R=301,L]

# IMPORTANT: API paths must never fall back to index.html.
RewriteRule ^api(?:/|$) api-relay.php [QSA,L]

# Serve real files (assets, JS, CSS, app bundles, fonts, music).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Support client-side routes /login, /register, /g/<slug>, /explore, etc.
RewriteRule ^ index.html [L]

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(g|success)(/|$)" MOMEVIA_PRIVATE=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=MOMEVIA_PRIVATE
  Header always set Cache-Control "private, no-store" env=MOMEVIA_PRIVATE
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "^api-relay\.php$">
    Header always set Cache-Control "private, no-store"
  </FilesMatch>
</IfModule>
